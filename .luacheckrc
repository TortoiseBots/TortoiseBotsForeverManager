-- Style-only findings of the upstream 2.4.1 code and of the mechanical handler
-- conversion (a handler parameter may shadow an enclosing local): ignored, the
-- port does not rewrite upstream logic. Everything else stays on.
ignore = {
    "432",
    "431",
    "231",
    "211", "212", "213",   -- unused local / unused function / unused argument (unused_args covers args)
    "311",                 -- value assigned to a local is unused
    "411", "412", "413",   -- shadowing a local / argument / upvalue
    "421", "422", "423",   -- same, as defined lines
    "143",                 -- accessing an undefined field of a standard table (compat probes)
}
